{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>soupglasses/renovate-configs#v0.1.0",
    "github>soupglasses/renovate-configs:providers#v0.1.0"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/ThePhaseless/terraform-provider-jellyfin"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/soupglasses/terraform-provider-jellyfin"
      ],
      "allowedVersions": "/-[0-9]{14}-[0-9a-f]{12}$/",
      "groupName": "Jellyfin Terraform fork"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/jellyfin-image\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr.io/soupglasses/ops/jellyfin-runtime):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
