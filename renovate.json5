{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>soupglasses/renovate-configs#v0.3.0",
    "github>soupglasses/renovate-configs:providers#v0.3.0"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/ThePhaseless/terraform-provider-jellyfin"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/soupglasses/terraform-provider-jellyfin"
      ],
      "allowedVersions": "/-[0-9]{14}-[0-9a-f]{12}$/",
      "groupName": "Jellyfin Terraform fork"
    }
  ]
}
